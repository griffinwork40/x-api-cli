# x-api — environment variables
#
# Copy to `.env` and fill in real values (never commit `.env`).
# Credentials come from the X Developer Console → your App → "Keys & Tokens":
#   https://console.x.com/  (legacy portal: https://developer.x.com/en/portal/dashboard)
#
# You do NOT need every group — provide the one(s) matching what you want to do.
# The CLI picks an auth mode from what's present (override with `--auth <mode>`).

# ── Group 1: App-only Bearer (public READS + streams; no user actions) ───────────
# Enables: tweet/user/search/timeline/space lookups, full-archive search & counts,
#          filtered/volume streams. CANNOT post, like, follow, DM, or hit /2/users/me.
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAA_replace_me

# ── Group 2: OAuth 1.0a user context (WRITES + user reads + media; legacy signer) ─
# All FOUR are required together. Enables: post/delete, like, follow, retweet, mute,
#          block, lists, DMs, media upload, /2/users/me. (NOT bookmarks — see Group 3.)
# Generate under Keys & Tokens with App permissions set to "Read and write" (or
# "Read, write, and DM") BEFORE minting, or the tokens come out read-only.
X_API_KEY=replace_me_consumer_key
X_API_SECRET=replace_me_consumer_secret
X_ACCESS_TOKEN=replace_me_user_access_token
X_ACCESS_TOKEN_SECRET=replace_me_user_access_token_secret

# ── Group 3: OAuth 2.0 user context (WRITES + user reads + media + BOOKMARKS) ─────
# A user access token from the OAuth 2.0 Authorization-Code-with-PKCE flow. This is
# the ONLY auth mode accepted for bookmarks. Same Authorization: Bearer header shape
# as Group 1 but a DIFFERENT identity — keep them in separate vars, never swap.
X_OAUTH2_ACCESS_TOKEN=replace_me_oauth2_user_access_token

# ── Optional: override the API base URL (default https://api.x.com/2) ─────────────
# Useful for tests/mocks or the legacy host https://api.twitter.com/2.
# X_API_BASE_URL=https://api.x.com/2
